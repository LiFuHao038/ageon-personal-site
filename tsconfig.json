{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "components/ui",
    "components/about.tsx",
    "components/custom-cursor.tsx",
    "components/footer.tsx",
    "components/section-blend.tsx",
    "components/smooth-scroll.tsx",
    "components/tech-marquee.tsx",
    "components/theme-provider.tsx",
    "components/works.tsx",
    "hooks/use-toast.ts",
    "lib/utils.ts"
  ]
}
